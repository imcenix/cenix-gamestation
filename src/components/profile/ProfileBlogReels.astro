---
import type { CollectionEntry } from 'astro:content';
interface Props { entries: CollectionEntry<'profileBlog'>[]; }
const { entries } = Astro.props;
const embedUrl = (url: string) => {
  try {
    const u = new URL(url);
    if (u.hostname.includes('youtube.com')) { const id=u.searchParams.get('v')||u.pathname.split('/').filter(Boolean).pop(); return id?`https://www.youtube.com/embed/${id}`:''; }
    if (u.hostname==='youtu.be') { const id=u.pathname.split('/').filter(Boolean)[0]; return id?`https://www.youtube.com/embed/${id}`:''; }
    if (u.hostname.includes('facebook.com')) return `https://www.facebook.com/plugins/video.php?href=${encodeURIComponent(url)}&show_text=false`;
  } catch {}
  return '';
};
const cards=entries.map((entry)=>({...entry.data,id:entry.id,image:entry.data.thumbnail?`/profile-blog/${entry.id}/${entry.data.thumbnail}`:'',embed:embedUrl(entry.data.url)}));
const blogs=cards.filter((card)=>card.type==='vlog');
const reels=cards.filter((card)=>card.type==='short');
const formatDate=(date:string)=>new Intl.DateTimeFormat('vi-VN',{day:'2-digit',month:'2-digit',year:'numeric'}).format(new Date(date));
---
<section class="profile-media" data-profile-stage aria-labelledby="profile-media-title">
  <div class="gut media-container">
    <header class="media-head">
      <div><p class="media-kicker">CENIX / OFF THE CLOCK</p><h2 id="profile-media-title">BLOG <span>&amp; REEL</span></h2></div>
      <p class="media-intro">Những chuyến đi, khoảnh khắc vui và một chút cá tính ngoài thế giới game.</p>
    </header>

    <div class="media-row">
      <div class="row-head"><h3><span>✦</span> BLOG</h3><small>{blogs.length} BÀI</small></div>
      <div class="row-track row-track--blog">
        {blogs.map((card)=><button class="media-card media-card--blog" type="button" data-open-media={card.id} aria-label={`Xem ${card.title}`}>
          <div class="media-cover">{card.image?<img src={card.image} alt="" loading="lazy"/>:<div class="media-placeholder">VLOG</div>}<span class="media-play" aria-hidden="true">▶</span><span class="media-kind">VLOG</span></div>
          <div class="media-copy"><span>{formatDate(card.date)}</span><h4>{card.title}</h4>{card.excerpt&&<p>{card.excerpt}</p>}</div>
        </button>)}
      </div>
    </div>

    <div class="media-row media-row--reels">
      <div class="row-head"><h3><span>✦</span> REEL</h3><small>{reels.length} REEL</small></div>
      <div class="row-track row-track--reels">
        {reels.map((card)=><button class="media-card media-card--reel" type="button" data-open-media={card.id} aria-label={`Xem ${card.title}`}>
          <div class="media-cover">{card.image?<img src={card.image} alt="" loading="lazy"/>:<div class="media-placeholder">REEL</div>}<span class="media-play" aria-hidden="true">▶</span><span class="media-kind">REEL</span></div>
          <div class="media-copy"><span>{formatDate(card.date)}</span><h4>{card.title}</h4>{card.excerpt&&<p>{card.excerpt}</p>}</div>
        </button>)}
      </div>
    </div>
  </div>
</section>

{cards.map((card)=><dialog class="media-dialog" id={`media-${card.id}`}><div class:list={['dialog-shell',{'dialog-shell--reel':card.type==='short'}]}><button type="button" class="dialog-close" aria-label="Đóng">×</button><div class="dialog-frame">{card.embed?<iframe data-src={card.embed} title={card.title} allow="autoplay; encrypted-media; fullscreen" allowfullscreen></iframe>:<a href={card.url} target="_blank" rel="noopener noreferrer">XEM TRÊN NỀN TẢNG GỐC →</a>}</div><div class="dialog-copy"><span>{card.type==='vlog'?'VLOG':'REEL'} · {formatDate(card.date)}</span><h3>{card.title}</h3>{card.excerpt&&<p>{card.excerpt}</p>}<a href={card.url} target="_blank" rel="noopener noreferrer">MỞ LINK GỐC ↗</a></div></div></dialog>)}
<script>
  document.querySelectorAll<HTMLElement>('[data-open-media]').forEach((trigger)=>trigger.addEventListener('click',()=>{const dialog=document.getElementById(`media-${trigger.dataset.openMedia}`) as HTMLDialogElement|null;if(!dialog)return;const frame=dialog.querySelector<HTMLIFrameElement>('iframe[data-src]');if(frame&&!frame.src)frame.src=frame.dataset.src??'';dialog.showModal();}));
  document.querySelectorAll<HTMLDialogElement>('.media-dialog').forEach((dialog)=>{const close=()=>{const frame=dialog.querySelector<HTMLIFrameElement>('iframe');if(frame)frame.src='';dialog.close();};dialog.querySelector('.dialog-close')?.addEventListener('click',close);dialog.addEventListener('click',(event)=>{if(event.target===dialog)close();});});
</script>
<style>
.profile-media{position:relative;width:100vw;margin-left:calc(50% - 50vw);padding:clamp(72px,9vw,124px) 0;overflow:hidden;border-top:1px solid var(--bd-divider);background:radial-gradient(circle at 84% 18%,rgba(200,240,60,.09),transparent 28%),#08090a}.profile-media:before{content:'OFFLINE';position:absolute;right:-.03em;bottom:-.12em;color:rgba(255,255,255,.025);font:900 clamp(110px,20vw,300px)/.8 var(--display);letter-spacing:-.08em;pointer-events:none}.media-container{position:relative;z-index:1;width:100%;max-width:var(--maxw);min-width:0;margin:0 auto;overflow:hidden}.media-head{display:flex;align-items:end;justify-content:space-between;gap:40px;margin-bottom:54px}.media-kicker{margin:0 0 12px;color:var(--lime);font:700 10px var(--mono);letter-spacing:1.6px}.media-head h2{font:900 clamp(42px,6vw,78px)/.9 var(--display);letter-spacing:-.06em}.media-head h2 span{color:var(--lime)}.media-intro{max-width:440px;margin:0;color:var(--tx-body);font:400 14px/1.65 var(--display)}.media-row{min-width:0}.media-row--reels{margin-top:54px;padding-top:42px;border-top:1px solid var(--bd-divider)}.row-head{display:flex;align-items:center;gap:14px;margin-bottom:20px}.row-head h3{font:900 22px var(--display);letter-spacing:.02em}.row-head h3 span{margin-right:8px;color:var(--lime)}.row-head small{color:var(--tx-meta);font:700 9px var(--mono);letter-spacing:1px}.row-head:after{content:'';flex:1;height:1px;background:var(--bd-card)}.row-track{display:flex;width:100%;max-width:100%;min-width:0;gap:18px;padding:0 0 12px;overflow-x:auto;overflow-y:hidden;overscroll-behavior-inline:contain;scroll-snap-type:x proximity;scrollbar-width:thin;scrollbar-color:var(--lime-40) transparent}.row-track--blog .media-card{flex:0 0 min(560px,calc(100vw - (var(--gutter) * 2)))}.row-track--reels .media-card{flex:0 0 clamp(190px,21vw,246px)}.media-card{min-width:0;padding:0;border:1px solid var(--bd-card);background:#101113;color:#fff;text-align:left;cursor:pointer;scroll-snap-align:start;transition:transform .25s,border-color .25s}.media-card:hover{transform:translateY(-4px);border-color:var(--lime-40)}.media-cover{position:relative;aspect-ratio:16/9;overflow:hidden;background:#17191c}.media-card--reel .media-cover{aspect-ratio:9/14}.media-cover img{width:100%;height:100%;object-fit:cover;transition:transform .45s}.media-card:hover img{transform:scale(1.035)}.media-cover:after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,transparent 48%,rgba(0,0,0,.58))}.media-placeholder{display:grid;place-items:center;width:100%;height:100%;color:var(--tx-meta);font:700 13px var(--mono);background:repeating-linear-gradient(135deg,#141619 0,#141619 12px,#191b1e 12px,#191b1e 24px)}.media-play{position:absolute;z-index:2;left:16px;bottom:14px;display:grid;place-items:center;width:38px;height:38px;border-radius:50%;background:var(--lime);color:#08090a;font-size:12px}.media-kind{position:absolute;z-index:2;right:12px;top:12px;padding:6px 8px;background:rgba(5,6,7,.78);color:var(--lime);font:700 9px var(--mono);letter-spacing:1px}.media-copy{padding:16px 17px 19px}.media-copy>span,.dialog-copy>span{color:var(--lime);font:700 9px var(--mono);letter-spacing:1px}.media-copy h4{margin:8px 0 0;font:800 17px/1.25 var(--display)}.media-copy p{margin:8px 0 0;color:var(--tx-body);font:400 12px/1.5 var(--display)}.media-dialog{width:min(1040px,calc(100vw - 32px));max-width:none;padding:0;border:1px solid rgba(255,255,255,.18);background:#0b0c0e;color:#fff}.media-dialog::backdrop{background:rgba(0,0,0,.82);backdrop-filter:blur(8px)}.dialog-shell{position:relative;display:grid;grid-template-columns:minmax(0,1.6fr) minmax(260px,.7fr)}.dialog-shell--reel{width:min(720px,100%);margin:auto;grid-template-columns:minmax(260px,.8fr) minmax(260px,.7fr)}.dialog-frame{display:grid;place-items:center;min-height:420px;background:#000}.dialog-shell--reel .dialog-frame{aspect-ratio:9/16;min-height:0;max-height:80vh}.dialog-frame iframe{width:100%;height:100%;min-height:420px;border:0}.dialog-shell--reel iframe{min-height:0}.dialog-frame a,.dialog-copy a{font:700 10px var(--mono)}.dialog-copy{padding:48px 30px 30px}.dialog-copy h3{margin:12px 0 14px;font:900 26px/1.1 var(--display)}.dialog-copy p{color:var(--tx-body);font:400 13px/1.6 var(--display)}.dialog-copy a{display:inline-block;margin-top:24px}.dialog-close{position:absolute;z-index:4;right:12px;top:12px;width:36px;height:36px;border:1px solid rgba(255,255,255,.2);border-radius:50%;background:rgba(0,0,0,.7);color:#fff;font-size:24px;cursor:pointer}@media(max-width:900px){.media-head{align-items:start}.dialog-shell,.dialog-shell--reel{grid-template-columns:1fr}.dialog-shell--reel .dialog-frame{max-height:65vh}.dialog-copy{padding:24px}.row-track--reels .media-card{flex-basis:220px}}@media(max-width:600px){.profile-media{padding:64px 0}.media-head{display:block;margin-bottom:42px}.media-intro{margin-top:20px}.media-row--reels{margin-top:40px;padding-top:34px}.row-track{gap:12px}.row-track--blog .media-card{flex-basis:calc(100vw - (var(--gutter) * 2))}.row-track--reels .media-card{flex-basis:178px}.media-copy{padding:12px}.media-copy h4{font-size:14px}.media-copy p{display:none}.dialog-frame,.dialog-frame iframe{min-height:240px}}
</style>